{
  "/api/v1/payments/create-intent": {
    "post": {
      "summary": "Create a new Stripe Payment Intent",
      "tags": ["Payments"],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["amount", "userEmail"],
              "properties": {
                "amount": { 
                  "type": "number", 
                  "example": 50 
                },
                "currency": { 
                  "type": "string", 
                  "example": "usd", 
                  "default": "usd" 
                },
                "userEmail": { 
                  "type": "string", 
                  "example": "customer@example.com" 
                },
                "userId": { 
                  "type": "string", 
                  "example": "60d0fe4f5311236168a109ca" 
                }
              }
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Payment Intent created successfully",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "success": { "type": "boolean", "example": true },
                  "statusCode": { "type": "number", "example": 201 },
                  "message": { "type": "string", "example": "Payment Intent created successfully" },
                  "data": {
                    "type": "object",
                    "properties": {
                      "clientSecret": { "type": "string", "example": "pi_12345_secret_67890" },
                      "transactionId": { "type": "string", "example": "pi_12345" },
                      "paymentRecordId": { "type": "string", "example": "60d0fe4f5311236168a109cb" }
                    }
                  }
                }
              }
            }
          }
        },
        "400": {
          "description": "Validation Error"
        },
        "500": {
          "description": "Server Error or Stripe API Error"
        }
      }
    }
  },
  "/api/v1/payments/create-checkout-session": {
    "post": {
      "summary": "Create a Stripe Checkout Session",
      "tags": ["Payments"],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["amount", "productName", "userEmail", "successUrl", "cancelUrl"],
              "properties": {
                "amount": { "type": "number", "example": 50 },
                "currency": { "type": "string", "example": "usd", "default": "usd" },
                "productName": { "type": "string", "example": "Premium Subscription" },
                "userEmail": { "type": "string", "example": "customer@example.com" },
                "userId": { "type": "string", "example": "60d0fe4f5311236168a109ca" },
                "successUrl": { "type": "string", "example": "http://localhost:3000/success" },
                "cancelUrl": { "type": "string", "example": "http://localhost:3000/cancel" }
              }
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Checkout Session created successfully",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "success": { "type": "boolean", "example": true },
                  "statusCode": { "type": "number", "example": 201 },
                  "message": { "type": "string", "example": "Checkout Session created successfully" },
                  "data": {
                    "type": "object",
                    "properties": {
                      "url": { "type": "string", "example": "https://checkout.stripe.com/c/pay/cs_test_..." },
                      "sessionId": { "type": "string", "example": "cs_test_..." },
                      "paymentRecordId": { "type": "string", "example": "60d0fe4f5311236168a109cb" }
                    }
                  }
                }
              }
            }
          }
        },
        "400": {
          "description": "Validation Error"
        }
      }
    }
  },
  "/api/v1/payments/create-connect-account": {
    "post": {
      "summary": "Create or Retrieve Stripe Connect Express Account & Onboarding Link",
      "description": "Automatically extracts user ID and email from Authorization Bearer JWT token.",
      "tags": ["Payments"],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "requestBody": {
        "required": false,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "refreshUrl": { "type": "string", "example": "http://localhost:3000/stripe/refresh" },
                "returnUrl": { "type": "string", "example": "http://localhost:3000/stripe/return" }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Stripe Connect onboarding link generated successfully",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "success": { "type": "boolean", "example": true },
                  "statusCode": { "type": "number", "example": 200 },
                  "message": { "type": "string", "example": "Stripe Connect onboarding link generated successfully" },
                  "data": {
                    "type": "object",
                    "properties": {
                      "url": { "type": "string", "example": "https://connect.stripe.com/setup/s/..." },
                      "stripeAccountId": { "type": "string", "example": "acct_1..." }
                    }
                  }
                }
              }
            }
          }
        },
        "400": { "description": "Validation Error" },
        "404": { "description": "User not found" }
      }
    }
  },
  "/api/v1/payments/connect-account-status/{accountId}": {
    "get": {
      "summary": "Get Stripe Connect Express Account Status & Capabilities",
      "tags": ["Payments"],
      "parameters": [
        {
          "name": "accountId",
          "in": "path",
          "required": true,
          "schema": { "type": "string" },
          "description": "Stripe Connect Account ID (e.g., acct_1...)"
        }
      ],
      "responses": {
        "200": {
          "description": "Stripe Connect account status retrieved successfully"
        },
        "500": {
          "description": "Failed to retrieve account details"
        }
      }
    }
  }
}
